# Environment Configuration for MOO E-Commerce

# Server Port
PORT=3000

# Environment mode (development / production)
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET="moo-super-secure-jwt-secret-key-2026"
REFRESH_SECRET="moo-super-secure-refresh-secret-key-2026"

# Database Connection (PostgreSQL with Prisma ORM for production deployment)
DATABASE_URL="postgresql://user:password@localhost:5432/moo_db?schema=public"

# Stripe Payment Gateway (Test / Live Mode)
STRIPE_SECRET_KEY="sk_test_51MockStripeKeyForMooStore"
STRIPE_WEBHOOK_SECRET="whsec_MockWebhookSecret"

# Optional Cloud Storage (Cloudinary or AWS S3)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
AWS_ACCESS_KEY_ID="your_aws_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret"
AWS_REGION="us-east-1"
S3_BUCKET="moo-product-media"
